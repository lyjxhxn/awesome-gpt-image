# Public browser configuration. The anon key is designed for clients and is protected by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Internal/private URL used only by the Node API. In local Windows development
# this is the public HTTPS URL of the isolated x86 test instance.
SUPABASE_URL=
# Server only. Never expose this value through a VITE_ variable or browser code.
SUPABASE_SERVICE_ROLE_KEY=
SUPER_ADMIN_EMAILS=lyjxhxn@qq.com

# Email-verification and invitation-code registration. Use a random value of at least 32 characters.
AUTH_REGISTRATION_HASH_SECRET=
AUTH_RATE_LIMIT_DISABLED=false

# SMTP is used for invitation and Supabase recovery emails.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Standalone Node API/server settings.
HOST=127.0.0.1
PORT=8787
# Vite proxies /api to this address during Windows development.
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# Optional platform generation key. Personal OpenAI-compatible keys stay in browser storage.
APIMART_API_KEY=

APP_URL=https://gpt-image2.canghe.ai
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Alipay production settings. Local sandbox development reads
# .alipay-sandbox.json directly and does not copy its keys into this file.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
# Dedicated callback for paid-community orders. Keep this separate from credit-pack fulfillment.
COMMUNITY_ALIPAY_NOTIFY_URL=https://gpt-image2.canghe.ai/api/community/alipay/notify
# Set to false only for local production-parameter acceptance without a public HTTPS callback.
ALIPAY_NOTIFY_ENABLED=true

# Paid community: production deployments must start with new payments disabled.
COMMUNITY_PAYMENT_ENABLED=false
COMMUNITY_SUPPORT_TEXT=微信搜索苍何

VITE_GA_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_REFRESH_TOKEN=

# Optional fallback when service account access is available.
GOOGLE_ANALYTICS_CLIENT_EMAIL=
GOOGLE_ANALYTICS_PRIVATE_KEY=

# Local helper only. Add this redirect URI to the Google OAuth client.
# These Google variables are for GA4 reporting only, not website login.
GOOGLE_ANALYTICS_REDIRECT_URI=http://localhost:8080/oauth2callback
